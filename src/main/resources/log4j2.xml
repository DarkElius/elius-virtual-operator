<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="ewa">
    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %tid %c{1}.%M() - %m%n" />
        </Console>
    </Appenders>
    <Loggers>
        <!-- Template application -->
        <Logger name="elius" level="TRACE"/>

        <!-- Jetty -->
        <Logger name="org.eclipse.jetty" level="WARN"/>

        <Root level="INFO">
            <AppenderRef ref="stdout"/>
        </Root>
    </Loggers>
</Configuration>