<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>EliusVirtualOperator</groupId>
	<artifactId>EliusVirtualOperator</artifactId>
	<version>0.0.3</version>

	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Elia Milioni</name>
			<organization>DarkElius</organization>
			<organizationUrl>https://github.com/DarkElius</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/DarkElius/elius-virtual-operator.git</connection>
		<developerConnection>scm:git:https://github.com/DarkElius/elius-virtual-operator.git</developerConnection>
		<url>https://github.com/DarkElius/elius-virtual-operator/tree/master</url>
	</scm>

	<build>
		<plugins>
			<!-- Compiler -->
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
				<configuration>
					<release>21</release>
				</configuration>
			</plugin>

			<!-- Fat Jar -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<!-- Fat-JAR with all dependencies -->
							<shadedArtifactAttached>false</shadedArtifactAttached>

							<!-- Remove external libraries signatures to avoid SecurityException
							errors -->
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>

							<!-- Set main class -->
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>elius.virtualoperator.VirtualOperatorMain</mainClass>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Java Source -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Java Doc -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.12.0</version>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- NOTICE -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>license-maven-plugin</artifactId>
				<version>2.4.0</version>

				<configuration>
					<thirdPartyFilename>NOTICE</thirdPartyFilename>
					<excludedScopes>test,provided</excludedScopes>
					<fileTemplate>
						${project.basedir}/src/main/resources/license/third-party-template.ftl</fileTemplate>
					<outputDirectory>${project.basedir}</outputDirectory>
				</configuration>

				<executions>
					<execution>
						<id>generate-notice</id>
						<goals>
							<goal>add-third-party</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<ewaf.version>0.0.3</ewaf.version>
		<evot.version>0.0.3</evot.version>
		<log4j.version>2.26.0</log4j.version>
		<derby.version>10.16.1.1</derby.version>
		<jackson.version>2.16.1</jackson.version>
		<jakarta.version>6.0.0</jakarta.version>
		<json.version>20240303</json.version>
		<commons-lang3.version>3.14.0</commons-lang3.version>
		<commons-text.version>1.11.0</commons-text.version>
	</properties>

	<dependencies>

		<!-- Elius Web Application Framework -->
		<dependency>
			<groupId>EliusWebAppFramework</groupId>
			<artifactId>EliusWebAppFramework</artifactId>
			<version>${ewaf.version}</version>
		</dependency>

		<!-- Elius Virtual Operator Task -->
		<dependency>
			<groupId>EliusVirtualOperator</groupId>
			<artifactId>Task</artifactId>
			<version>${evot.version}</version>
		</dependency>

		<!-- Logging -->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-core</artifactId>
			<version>${log4j.version}</version>
		</dependency>
		<!-- SLF4J Log4j2 -->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-slf4j2-impl</artifactId>
			<version>${log4j.version}</version>
		</dependency>

		<!-- Apache Derby DB -->
		<dependency>
			<groupId>org.apache.derby</groupId>
			<artifactId>derby</artifactId>
			<version>${derby.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Json to java object -->
		<dependency>
			<groupId>com.fasterxml.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-xml</artifactId>
			<version>${jackson.version}</version>
		</dependency>

		<!-- Jakarta Servlet Http -->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>${jakarta.version}</version>
		</dependency>

		<!-- JSON -->
		<dependency>
			<groupId>org.json</groupId>
			<artifactId>json</artifactId>
			<version>${json.version}</version>
		</dependency>

		<!-- StringUtils -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>${commons-lang3.version}</version>
		</dependency>

		<!-- Escape HTML -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-text</artifactId>
			<version>${commons-text.version}</version>
		</dependency>

	</dependencies>

    <profiles>
		<!-- SonarQube -->
        <profile>
            <id>sonar</id>
            <properties>
				<sonar.projectKey>elius-virtual-operator</sonar.projectKey>
				<sonar.projectName>elius-virtual-operator</sonar.projectName>
                
				<sonar.host.url>${env.SONAR_HOST_URL}</sonar.host.url>
				<sonar.host.token>${env.SONAR_TOKEN}</sonar.host.token>

				<sonar.plugin.version>5.8.0.7211</sonar.plugin.version>
				<sonar.scanner.skipJreProvisioning>true</sonar.scanner.skipJreProvisioning>
				<sonar.cpd.exclusions>**/*.html</sonar.cpd.exclusions>
				<sonar.java.binaries>target</sonar.java.binaries>		
            </properties>

			<build>
				<plugins>
					<plugin>
						<groupId>org.sonarsource.scanner.maven</groupId>
						<artifactId>sonar-maven-plugin</artifactId>
						<version>${sonar.plugin.version}</version>
					</plugin>					
				</plugins>
			</build>
        </profile>
		
    </profiles>

</project>